# =============================================================================
# Zentrix.ai — Environment Variables (.env.example)
# Reference: ARCHITECTURE.md §11
# =============================================================================
# Copy this file to `.env` (or `apps/backend/.env`) and fill in real values.
# NEVER commit `.env` files containing real secrets to version control.

# ─── Environment & Application ──────────────────────────────────────────────
ENVIRONMENT=development
NODE_ENV=development
API_PORT=8000

# ─── Application Database (PostgreSQL / Neon) ────────────────────────────────
# Connection string to the application Postgres/Neon instance (asyncpg driver)
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zentrix

# ─── Authentication & Secrets ────────────────────────────────────────────────
# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
# Development only: lets Connections and Monitoring run before auth UI is wired.
# Keep false in any shared or production environment.
DEV_CONNECTIONS_WITHOUT_AUTH=true

# ─── Connection Credential Encryption ────────────────────────────────────────
# Fernet key used to encrypt customer database connection strings at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=change-this-to-a-valid-fernet-key-e.g.-44-char-base64=

# ─── MLflow Tracking ─────────────────────────────────────────────────────────
# URI where models, metrics, and experiments are tracked
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Worker Configuration ────────────────────────────────────────────────────
# Polling frequency per connected customer database (seconds)
TELEMETRY_POLL_INTERVAL_SECONDS=60

# Canary observation duration before auto-commit / rollback evaluation (minutes)
CANARY_MONITOR_WINDOW_MINUTES=15

# Docker image used to clone customer databases for safe shadow experiments
SHADOW_DB_IMAGE=zentrix-shadow-db:latest

# ─── Frontend Configuration ──────────────────────────────────────────────────
# Base URL the frontend calls for REST / SSE endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

